# Copy to secrets.yaml (not committed) or add these entries to your ESPHome dashboard's secrets.yaml.
# API encryption key, generate with: openssl rand -base64 32
signal_ring_api_key: "REPLACE-WITH-YOUR-OWN-KEY"
# OTA password for updates from the ESPHome dashboard
signal_ring_ota_password: "change-me-please"
wifi_ssid: "MyWiFi"
wifi_password: "my-wifi-password"
# Password of the fallback hotspot that opens when WiFi is unreachable (at least 8 characters)
signal_ring_ap_password: "change-me-please"
